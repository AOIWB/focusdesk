{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main workspace window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "sql:default",
    "sql:allow-execute",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}
