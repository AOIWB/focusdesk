{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinecone",
  "version": "0.2.0",
  "identifier": "app.focusdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "松果 Pinecone",
        "width": 1440,
        "height": 980,
        "minWidth": 960,
        "minHeight": 760,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "松果 Pinecone — 让重要的事，浮现。",
    "category": "Productivity"
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:focusdesk.db"
      ]
    }
  }
}
